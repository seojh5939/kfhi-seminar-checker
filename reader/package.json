{
  "name": "reader",
  "version": "1.2.0",
  "description": "기아대책 출입관리 QR 인식기",
  "author": "KFHI",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build": "vite build --config vite.main.config.ts && vite build",
    "dev": "vite",
    "start": "electron .",
    "test": "jest",
    "package:win": "pnpm build && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.kfhi.reader",
    "productName": "기아대책 출입관리 QR 인식기",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "기아대책 QR 인식기"
    }
  },
  "dependencies": {
    "qr-scanner": "^1.4.2",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
