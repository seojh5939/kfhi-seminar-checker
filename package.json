{
  "name": "kfhi-seminar-checker-monorepo",
  "version": "1.2.0",
  "private": true,
  "workspaces": [
    "shared",
    "generator",
    "reader"
  ],
  "scripts": {
    "build:shared": "pnpm --filter shared build",
    "build:generator": "pnpm --filter generator build",
    "start:generator": "pnpm --filter generator start",
    "dev:generator": "pnpm --filter generator dev",
    "build:reader": "pnpm --filter reader build",
    "start:reader": "pnpm --filter reader start",
    "dev:reader": "pnpm --filter reader dev",
    "build:all": "pnpm build:shared && pnpm build:generator && pnpm build:reader",
    "package:win:reader": "pnpm --filter reader package:win",
    "package:win:generator": "pnpm --filter generator package:win",
    "package:win:all": "pnpm build:shared && pnpm package:win:generator && pnpm package:win:reader",
    "test:shared": "pnpm --filter shared test",
    "test": "pnpm test:shared"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
